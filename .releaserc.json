{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/github", { "assets": [{ "path": "keepessence-extension.zip", "label": "KeepEssence extension (unpack, then load it unpacked)" }] }]
  ]
}
